# Copy this file to .env and fill in real values. Never commit .env itself.

# Server
PORT=5001

# Comma-separated list of allowed frontend origins for CORS in production.
# Example: https://legaleaseai.netlify.app
# Leave empty for local development (allows all origins).
FRONTEND_URL=

# MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=legaleaseai
DB_PORT=3306

# Admin authentication
# Generate the hash with: node generate-admin-hash.js "YourStrongPassword"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Use a long, random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-this-to-a-long-random-string
